# Claude Code local settings
.claude/

# Database - the working cache is ~167 MB and is rebuilt by
# scrape_fso.py. The shipped build seeds its own copy; see PLAN.md.
*.db
*.db-journal
fsostats.db*

# The prepared shipping database (fsostats/data/fsostats.db.gz, 18.6 MB)
# is a build artefact, not source: `python -m fsostats.prepare_db`
# regenerates it from fsostats.db. It travels as a release asset
# alongside the exe rather than in the repository, so that rebuilding
# doesn't add another 18 MB blob to history every time.
fsostats/data/

# Logs
*.log

# Scraped pages kept locally for parser development
*_response.html
event_logs_landing.html
*.har

# TLS certificate captured from ahevents.net for reference
cert.pem

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# UI preferences written next to the code when running from source
# (packaged builds keep this in %LOCALAPPDATA%).
settings.json

# Per-run scrape reports: which events did not come back clean.
# Regenerated by scrape_fso.py --report.
scrape_report_*.tsv

# Non-FSO scrapes go to their own database (see scrape_fso.py --db).
scrape_*.db
